# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# ---- MongoDB Atlas ----
# Atlas -> Database -> Connect -> Drivers -> copy the connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pritt-photography?retryWrites=true&w=majority
# Optional: only if the database name is not already inside MONGODB_URI
MONGODB_DB=

# ---- Admin login (JWT) ----
# Random secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used ONLY by `npm run admin:create` — remove ADMIN_PASSWORD from the file afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Cloudinary (image storage) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder for uploads (photos go to <folder>/gallery, site images to <folder>/site)
CLOUDINARY_FOLDER=pritt-photography

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Optional: e-mail alert for new contact messages (https://resend.com) ----
# Messages are always saved in MongoDB and shown in Admin -> Contact Messages.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
