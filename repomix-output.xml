<file path="app/globals.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

/*
 * Design tokens (space-separated RGB so Tailwind can add opacity: bg-ink/50).
 * Dark = default editorial theme. Light = intentionally designed, not inverted.
 * The theme is chosen by <html data-theme="dark|light"> (set before paint by the
 * inline script in app/layout.js, so there is no flash of the wrong theme).
 */
:root,
:root[data-theme="dark"] {
  --bg: 10 10 10; /* #0A0A0A */
  --bg2: 17 17 17; /* #111111 */
  --surface: 23 23 23; /* #171717 */
  --border: 42 42 42; /* #2A2A2A */
  --text: 245 240 232; /* #F5F0E8 */
  --muted: 166 161 154; /* #A6A19A */
  --accent: 191 164 119; /* #BFA477 */
  --accent-text: 191 164 119;
  --danger: 232 134 124;
  color-scheme: dark;
}

:root[data-theme="light"] {
  --bg: 247 245 240; /* #F7F5F0 */
  --bg2: 238 234 226; /* #EEEAE2 */
  --surface: 255 255 255; /* #FFFFFF */
  --border: 221 216 206; /* #DDD8CE */
  --text: 23 23 23; /* #171717 */
  --muted: 105 101 94; /* #69655E */
  --accent: 146 116 72; /* #927448 */
  --accent-text: 122 95 54; /* darker champagne so small text keeps AA contrast */
  --danger: 176 54 42;
  color-scheme: light;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  background: rgb(var(--bg));
  color: rgb(var(--text));
  font-family: var(--font-body), system-ui, sans-serif;
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Smooth, flash-free theme change: the class lives on <html> for ~0.5s after a toggle. */
html.theme-transition,
html.theme-transition *,
html.theme-transition *::before,
html.theme-transition *::after {
  transition: background-color 0.45s ease, color 0.45s ease, border-color 0.45s ease, fill 0.45s ease !important;
}

::selection {
  background: rgb(var(--accent));
  color: #0a0a0a;
}

a,
button {
  -webkit-tap-highlight-color: transparent;
}

:focus-visible {
  outline: 1px solid rgb(var(--accent-text));
  outline-offset: 4px;
}

@layer components {
  .eyebrow {
    @apply text-[11px] font-semibold uppercase tracking-caps text-mute;
  }
  .link-underline {
    position: relative;
    display: inline-block;
  }
  .link-underline::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .link-underline:hover::after,
  .link-underline[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .btn-outline {
    @apply inline-flex min-h-[48px] items-center gap-3 border border-bone px-8 py-4 text-[12px] font-semibold uppercase tracking-caps text-bone transition-colors duration-500 hover:bg-bone hover:text-ink;
  }
  .btn-solid {
    @apply inline-flex min-h-[48px] items-center gap-3 bg-bone px-8 py-4 text-[12px] font-semibold uppercase tracking-caps text-ink transition-colors duration-500 hover:bg-sand disabled:opacity-60;
  }
  /* Admin form controls */
  .a-input {
    @apply w-full border border-line bg-ink px-3 py-2.5 text-[14px] text-bone placeholder:text-mute/70 focus:border-sand focus:outline-none;
  }
  .a-btn {
    @apply inline-flex min-h-[40px] items-center justify-center gap-2 border border-line px-4 py-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-bone transition-colors hover:border-bone disabled:cursor-not-allowed disabled:opacity-40;
  }
  .a-btn-primary {
    @apply inline-flex min-h-[40px] items-center justify-center gap-2 border border-bone bg-bone px-4 py-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-ink transition-opacity hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-40;
  }
  .a-btn-danger {
    @apply inline-flex min-h-[40px] items-center justify-center gap-2 border border-danger px-4 py-2 text-[12px] font-semibold uppercase tracking-[0.14em] text-danger transition-colors hover:bg-danger hover:text-ink disabled:cursor-not-allowed disabled:opacity-40;
  }
}

/* Custom cursor only on precise pointers */
.cursor-layer {
  display: none;
}
@media (hover: hover) and (pointer: fine) {
  .cursor-layer {
    display: block;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Swiper theme overrides for the lightbox */
.lightbox-swiper .swiper-button-prev,
.lightbox-swiper .swiper-button-next {
  display: none;
}
.thumbs-swiper .swiper-slide {
  opacity: 0.45;
  transition: opacity 0.3s;
  cursor: pointer;
}
.thumbs-swiper .swiper-slide-thumb-active {
  opacity: 1;
}
