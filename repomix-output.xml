<file path="lib/admin/slug.js">
import { slugify } from "@/lib/validation";

/** Returns `base`, or `base-2`, `base-3`… so the slug is unique within the collection. */
export async function uniqueSlug(model, base, excludeId = null) {
  const root = slugify(base) || "item";
  let candidate = root;
  for (let n = 2; n < 500; n++) {
    const clash = await model.exists({ slug: candidate, ...(excludeId ? { _id: { $ne: excludeId } } : {}) });
    if (!clash) return candidate;
    candidate = `${root}-${n}`;
  }
  return `${root}-${Date.now()}`;
}
</file>

<file path="lib/auth/jwt.js">
/**
 * JWT helpers (jose, HS256). Edge-safe: this file is imported by middleware.js,
 * so it must not import mongoose, bcrypt or any Node-only module.
 */
import { SignJWT, jwtVerify } from "jose";

export const COOKIE_NAME = "pp_admin_session";
export const SESSION_SECONDS = 60 * 60 * 8; // 8 hours
const ISSUER = "pritt-photography";
const AUDIENCE = "admin";

function secretKey() {
  const secret = process.env.JWT_SECRET;
  if (!secret || secret.length < 32) {
    throw new Error("JWT_SECRET is missing or shorter than 32 characters.");
  }
  return new TextEncoder().encode(secret);
}

/** @param {{sub: string, email: string, ver: number}} claims */
export async function signToken({ sub, email, ver }) {
  return new SignJWT({ email, ver, role: "admin" })
    .setProtectedHeader({ alg: "HS256" })
    .setSubject(sub)
    .setIssuer(ISSUER)
    .setAudience(AUDIENCE)
    .setIssuedAt()
    .setExpirationTime(`${SESSION_SECONDS}s`)
    .sign(secretKey());
}

/** Returns the verified payload, or null for a missing / invalid / expired token. */
export async function verifyToken(token) {
  if (!token) return null;
  try {
    const { payload } = await jwtVerify(token, secretKey(), {
      algorithms: ["HS256"],
      issuer: ISSUER,
      audience: AUDIENCE,
    });
    return payload.role === "admin" ? payload : null;
  } catch {
    return null;
  }
}
</file>

<file path="lib/auth/rate-limit.js">
/**
 * Best-effort in-memory sliding-window limiter (per server instance).
 * Login also has a durable per-account lockout stored in MongoDB, so this layer
 * only needs to blunt bursts from a single IP.
 */
const buckets = new Map();

/** @returns {boolean} true when the caller is OVER the limit */
export function rateLimited(key, limit, windowMs) {
  const now = Date.now();
  const recent = (buckets.get(key) || []).filter((t) => now - t < windowMs);
  recent.push(now);
  buckets.set(key, recent);
  if (buckets.size > 5000) {
    for (const [k, v] of buckets) if (!v.some((t) => now - t < windowMs)) buckets.delete(k);
  }
  return recent.length > limit;
}

export function clientIp(request) {
  return (request.headers.get("x-forwarded-for") || request.headers.get("x-real-ip") || "unknown").split(",")[0].trim();
}
</file>

<file path="lib/auth/session.js">
/**
 * Server-side session / authorization (Node runtime only).
 *
 * Two layers protect the admin area:
 *   1. middleware.js     — fast JWT signature + expiry check (Edge)
 *   2. this file         — authoritative check: valid JWT AND the admin still exists in
 *                          MongoDB AND the token's version matches (logout bumps it).
 *
 * Every admin Route Handler is wrapped in `handle()` and calls `requireAdmin()` first.
 */
import { cookies } from "next/headers";
import { redirect } from "next/navigation";
import { NextResponse } from "next/server";
import { connectDB } from "@/lib/db/connect";
import { Admin } from "@/lib/db/models";
import { COOKIE_NAME, SESSION_SECONDS, verifyToken } from "@/lib/auth/jwt";
import { ValidationError } from "@/lib/validation";

export class HttpError extends Error {
  constructor(status, message) {
    super(message);
    this.status = status;
  }
}

const NO_STORE = { "Cache-Control": "no-store, max-age=0" };

export function json(data, status = 200) {
  return NextResponse.json(data, { status, headers: NO_STORE });
}

async function adminFromPayload(payload) {
  if (!payload) return null;
  await connectDB();
  const admin = await Admin.findById(payload.sub).select("email tokenVersion").lean();
  if (!admin || (admin.tokenVersion ?? 0) !== (payload.ver ?? 0)) return null;
  return { id: String(admin._id), email: admin.email };
}

/** For Server Components: current admin or null. */
export async function getSession() {
  try {
    const store = await cookies();
    return await adminFromPayload(await verifyToken(store.get(COOKIE_NAME)?.value));
  } catch {
    return null;
  }
}

/** For protected pages: redirects to the login page when not signed in. */
export async function requireAdminPage() {
  const session = await getSession();
  if (!session) redirect("/admin");
  return session;
}

/** CSRF defence for cookie auth: mutating requests must come from our own origin. */
export function assertSameOrigin(request) {
  if (["GET", "HEAD", "OPTIONS"].includes(request.method)) return;
  const origin = request.headers.get("origin");
  const host = request.headers.get("x-forwarded-host") || request.headers.get("host");
  let ok = false;
  try {
    ok = Boolean(origin && host && new URL(origin).host === host);
  } catch {
    ok = false;
  }
  if (!ok) throw new HttpError(403, "Request blocked.");
}

/** For Route Handlers: throws HttpError(401) unless a valid admin session exists. */
export async function requireAdmin(request) {
  assertSameOrigin(request);
  const payload = await verifyToken(request.cookies.get(COOKIE_NAME)?.value);
  const admin = await adminFromPayload(payload);
  if (!admin) throw new HttpError(401, "Please sign in again.");
  return admin;
}

export function setSessionCookie(response, token) {
  response.cookies.set(COOKIE_NAME, token, {
    httpOnly: true,
    secure: process.env.NODE_ENV === "production",
    sameSite: "lax",
    path: "/",
    maxAge: SESSION_SECONDS,
  });
}

export function clearSessionCookie(response) {
  response.cookies.set(COOKIE_NAME, "", {
    httpOnly: true,
    secure: process.env.NODE_ENV === "production",
    sameSite: "lax",
    path: "/",
    maxAge: 0,
  });
}

/** Wraps a Route Handler: maps known errors to safe JSON, hides internals. */
export function handle(fn) {
  return async (request, context) => {
    try {
      return await fn(request, context);
    } catch (err) {
      if (err instanceof HttpError) return json({ ok: false, message: err.message }, err.status);
      if (err instanceof ValidationError) return json({ ok: false, message: err.message, errors: err.errors }, 422);
      if (err?.code === 11000) return json({ ok: false, message: "That value is already in use." }, 409);
      if (err?.name === "CastError") return json({ ok: false, message: "Not found." }, 404);
      console.error("[admin api]", request.method, request.nextUrl?.pathname, err);
      return json({ ok: false, message: "Something went wrong. Please try again." }, 500);
    }
  };
}

/** Parses a JSON body or throws a 400. */
export async function readJson(request) {
  try {
    return await request.json();
  } catch {
    throw new HttpError(400, "Invalid request body.");
  }
}
</file>

<file path="lib/cloudinary/index.js">
/**
 * Cloudinary (server only). The API secret never leaves this file / the server.
 *
 * Upload flow (signed direct upload — works on Vercel, which limits request bodies to ~4.5 MB):
 *   1. Browser asks  POST /api/admin/uploads/sign          -> signed params (admin only)
 *   2. Browser sends the file straight to Cloudinary        (shows real upload progress)
 *   3. Browser calls POST /api/admin/photos with the publicId
 *   4. Server re-reads the asset from Cloudinary (verifyAsset) and only then saves it
 *      to MongoDB — nothing the browser claims about size/format is trusted.
 */
import { v2 as cloudinary } from "cloudinary";
import { HttpError } from "@/lib/auth/session";

export const ALLOWED_FORMATS = ["jpg", "jpeg", "png", "webp", "avif"];
export const MAX_BYTES = 25 * 1024 * 1024; // 25 MB per photograph

export function isCloudinaryConfigured() {
  return Boolean(process.env.CLOUDINARY_CLOUD_NAME && process.env.CLOUDINARY_API_KEY && process.env.CLOUDINARY_API_SECRET);
}

function configure() {
  if (!isCloudinaryConfigured()) throw new HttpError(503, "Cloudinary is not configured on the server.");
  cloudinary.config({
    cloud_name: process.env.CLOUDINARY_CLOUD_NAME,
    api_key: process.env.CLOUDINARY_API_KEY,
    api_secret: process.env.CLOUDINARY_API_SECRET,
    secure: true,
  });
  return cloudinary;
}

export function baseFolder() {
  return (process.env.CLOUDINARY_FOLDER || "pritt-photography").replace(/^\/+|\/+$/g, "");
}

/** Browsers can only pick one of these two destinations — never an arbitrary folder. */
export function folderFor(kind) {
  return kind === "site" ? `${baseFolder()}/site` : `${baseFolder()}/gallery`;
}

export function signUpload(kind) {
  const c = configure();
  const timestamp = Math.round(Date.now() / 1000);
  const folder = folderFor(kind);
  const allowed_formats = ALLOWED_FORMATS.join(",");
  const signature = c.utils.api_sign_request({ allowed_formats, folder, timestamp }, process.env.CLOUDINARY_API_SECRET);
  return {
    uploadUrl: `https://api.cloudinary.com/v1_1/${process.env.CLOUDINARY_CLOUD_NAME}/image/upload`,
    apiKey: process.env.CLOUDINARY_API_KEY,
    timestamp,
    signature,
    folder,
    allowedFormats: allowed_formats,
    maxBytes: MAX_BYTES,
  };
}

/** Confirms an uploaded asset really exists in OUR folder and meets the limits. */
export async function verifyAsset(publicId, kind) {
  const c = configure();
  if (typeof publicId !== "string" || !publicId.startsWith(`${folderFor(kind)}/`)) {
    throw new HttpError(400, "That image is not in the allowed upload folder.");
  }
  let asset;
  try {
    asset = await c.api.resource(publicId, { resource_type: "image" });
  } catch {
    throw new HttpError(400, "The uploaded image could not be found on Cloudinary.");
  }
  const format = String(asset.format || "").toLowerCase();
  if (!ALLOWED_FORMATS.includes(format) || asset.bytes > MAX_BYTES) {
    await c.uploader.destroy(publicId, { invalidate: true, resource_type: "image" }).catch(() => {});
    throw new HttpError(400, "Only JPG, PNG, WebP or AVIF images up to 25 MB are allowed.");
  }
  return {
    url: asset.secure_url,
    publicId: asset.public_id,
    width: asset.width,
    height: asset.height,
    format,
    bytes: asset.bytes,
  };
}

/** Deletes one asset, but only inside our own folder. Failures are logged, never thrown. */
export async function destroyAsset(publicId) {
  try {
    if (!publicId || !String(publicId).startsWith(`${baseFolder()}/`)) return;
    await configure().uploader.destroy(publicId, { invalidate: true, resource_type: "image" });
  } catch (err) {
    console.error("[cloudinary] destroy failed for", publicId, err?.message || err);
  }
}
</file>

