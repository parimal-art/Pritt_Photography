<file path="middleware.js">
import { NextResponse } from "next/server";
import { COOKIE_NAME, verifyToken } from "@/lib/auth/jwt";

/**
 * First line of defence for the admin area (Edge runtime — it only checks the JWT
 * signature and expiry). The second, authoritative check happens on the server in
 * `requireAdminPage()` / `requireAdmin()`, which also confirm the admin in MongoDB.
 *
 *   /admin              -> login page (public, not linked from anywhere on the site)
 *   /admin/dashboard/*  -> needs a valid session, otherwise redirect to /admin
 *   /api/admin/*        -> needs a valid session, otherwise 401 JSON (login excepted)
 */
export async function middleware(request) {
  const { pathname } = request.nextUrl;
  const isApi = pathname.startsWith("/api/admin");
  const isLogin = pathname === "/api/admin/auth/login";
  const isProtectedPage = pathname.startsWith("/admin/dashboard");

  if ((isApi && !isLogin) || isProtectedPage) {
    const session = await verifyToken(request.cookies.get(COOKIE_NAME)?.value).catch(() => null);
    if (!session) {
      if (isApi) {
        return NextResponse.json(
          { ok: false, message: "Please sign in again." },
          { status: 401, headers: { "Cache-Control": "no-store" } }
        );
      }
      return NextResponse.redirect(new URL("/admin", request.url));
    }
  }

  const response = NextResponse.next();
  // Private area: never cached by browsers/CDNs, never indexed by search engines.
  response.headers.set("Cache-Control", "no-store, max-age=0");
  response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
  return response;
}

export const config = {
  matcher: ["/admin/:path*", "/api/admin/:path*"],
};
</file>

